<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Parent de Spring Boot.
        Se utiliza una versión estable y reproducible
        para la entrega del proyecto.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!--
        Información general del proyecto EcoVida.
    -->
    <groupId>com.ecovidasas</groupId>
    <artifactId>ecovida-springboot</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>ecovida-springboot</name>

    <!--
        Versión de Java utilizada por el proyecto.
    -->
    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!--
            Spring Boot Web.
            Permite desarrollar los controladores REST
            y exponer los servicios web del sistema.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Spring Data JPA.
            Permite trabajar con las entidades y
            la persistencia de información en MySQL.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            Validaciones.
            Permite validar los datos recibidos
            en las solicitudes REST.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Servicios Web.
            Se mantiene porque forma parte
            de la configuración actual del proyecto.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web-services</artifactId>
        </dependency>

        <!--
            Spring Security.
            Se utiliza para autenticación,
            autorización y protección de recursos.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            Conector MySQL.
            Permite conectar Spring Boot
            con la base de datos EcoVida.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            JWT API.
            Define las clases necesarias para
            crear y validar tokens JWT.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>

        <!--
            Implementación de JWT.
            Se utiliza durante la ejecución
            de la aplicación.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            Integración de JWT con Jackson.
            Permite manejar la información
            contenida en los tokens.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            Dependencias para pruebas.
            Incluye las herramientas de testing
            proporcionadas por Spring Boot.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!--
        Plugin de Maven para ejecutar, compilar
        y empaquetar la aplicación Spring Boot.
    -->
    <build>
        <plugins>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>